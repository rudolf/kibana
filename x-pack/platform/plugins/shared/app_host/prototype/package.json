{
  "name": "app-host-prototype-tools",
  "private": true,
  "version": "0.0.0",
  "license": "Elastic License 2.0",
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "wrangler dev --config cloudflare/wrangler.jsonc --ip 127.0.0.1",
    "secret:local": "tsx scripts/secret_local.ts",
    "dev:probe": "wrangler dev --config cloudflare/wrangler.probe.jsonc --ip 127.0.0.1 --port 8788 --inspector-port 9230 --persist-to .local/probe-state",
    "seam": "tsx scripts/seam.ts",
    "seed": "tsx scripts/seed.ts",
    "release": "tsx scripts/release.ts",
    "acceptance": "tsx scripts/acceptance.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p cloudflare/tsconfig.json",
    "test": "npm run -s typecheck && tsx --test 'test/*_test.ts'",
    "kibana:config": "tsx scripts/local_kibana_config.ts",
    "ui-check": "tsx scripts/ui_check.ts"
  },
  "dependencies": {
    "capnweb": "0.12.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.157.0"
  }
}
